# ==========================================
# 1. AI Model & API Keys (Gemini)
# ==========================================
# 요약·중요도 스코어링·벡터화·AI Agent (키 로테이션, 콤마 구분)
GEMINI_API_KEYS=


# ==========================================
# 2. Naver News Search API
# ==========================================
# 네이버 뉴스 검색 API (hana_p와 동일 앱 키 재사용, 없으면 네이버 수집 자동 건너뜀)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# ==========================================
# 3. Reddit API (미기재 - 선택 사항)
# ==========================================
# Reddit OAuth(client_credentials) — reddit.com/prefs/apps 에서 "script" 타입 앱 생성 후 발급
# 없으면 Reddit 수집만 자동으로 건너뜀
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=


# ==========================================
# 4. YouTube API (미기재 - 선택 사항)
# ==========================================
# 현재 방식(채널 RSS)에는 불필요 — 향후 API 기반 수집으로 바꿀 경우에만 필요
YOUTUBE_API_KEY=


# ==========================================
# 5. Teams Webhook (더 이상 사용 안 함)
# ==========================================
# 웹훅 URL은 .엔브이가 아니라 앱 내 '설정 > 웹훅 관리' 탭에서 관리됨 (data/webhooks.json에 저장)
# TEAMS_WEBHOOK_URL 은 주석 처리 또는 제거 상태 유지


# ==========================================
# 6. Deployment Server Settings (SSH & Port)
# ==========================================
# hana_p와 동일 서버·계정 재사용 (SSH 연결 확인 완료)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PASS=

# 배포 세부 설정 (9922 포트, 원격 경로, 4001 포트 통일)
DEPLOY_SSH_PORT=
DEPLOY_REMOTE_PATH=
DEPLOY_APP_PORT=